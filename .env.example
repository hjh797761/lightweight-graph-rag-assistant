# Optional answer API (not used by local evidence retrieval/builds)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# Choose a NEW filename for evidence mode. Old indexes are never auto-converted.
KB_PATH=evidence.sqlite3
RETRIEVAL_PROFILE=evidence
OFFLINE_MODE=1
BUILD_BATCH_SIZE=20

# Real local models by default; deterministic is only for local smoke tests.
EMBEDDING_BACKEND=sentence_transformer
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
ENABLE_CROSS_ENCODER=1
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# Evidence candidate and rendered context limits (characters, not model tokens)
EVIDENCE_CANDIDATE_K=40
EVIDENCE_LEXICAL_K=40
EVIDENCE_RRF_K=60
EVIDENCE_MAX_CHUNKS=6
EVIDENCE_MAX_SUPPLEMENTS=2
EVIDENCE_CONTEXT_BUDGET=6000
EVIDENCE_SUPPLEMENT_FRACTION=0.30
EVIDENCE_BUDGET_UNIT=characters

# Explicit legacy profiles: vector, vector_keyword, vector_graph, vector_topic_graph, full
VECTOR_RECALL_K=40
FINAL_TOP_K=6
